---
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={post.data.description ?? post.data.title} />
    <title>{post.data.title} — {siteConfig.name}</title>
    <script is:inline>
      document.documentElement.classList.add('dark');
    </script>
  </head>
  <body>
    <main>
      <article>
        <header>
          <h1>{post.data.title}</h1>
          <div class="meta">
            <span class="date">{formatDate(post.data.date)}</span>
            {post.data.tags && post.data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          {post.data.description && (
            <p class="description">{post.data.description}</p>
          )}
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  body {
    background-color: #2d353b;
    color: #d3c6aa;
    margin: 0;
    padding: 0;
    font-family: 'Times New Roman', serif;
    min-height: 100vh;
  }

  /* Keep the whole blog on Times New Roman, overriding the global
     Inter/IBM Plex Mono rules from global.css */
  main,
  main :global(*) {
    font-family: 'Times New Roman', serif;
  }

  main {
    max-width: 1100px;
    margin: 0;
    padding: 4rem 3rem 6rem;
  }

  header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #3c484f;
  }

  h1 {
    color: #e5dfc8;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .date {
    color: #5c6a72;
    font-size: 0.85rem;
    font-family: 'Times New Roman', serif;
  }

  .tag {
    background: #3c484f;
    color: #9da9a0;
    padding: 0.15rem 0.6rem;
    border-radius: 3px;
    font-size: 0.75rem;
    font-family: 'Times New Roman', serif;
    border: 1px solid #475258;
  }

  .description {
    color: #9da9a0;
    font-size: 1.15rem;
    margin: 0;
    line-height: 1.55;
  }

  /* Prose */
  .prose {
    font-size: 1.875rem;
    line-height: 1.7;
    color: #c8c3aa;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5rem 0;
  }

  .prose :global(h1) {
    color: #e5dfc8;
    font-size: 1.9rem;
    font-weight: 700;
    margin: 2.5rem 0 0.75rem;
    line-height: 1.3;
  }

  .prose :global(h2) {
    color: #e5dfc8;
    font-size: 1.6rem;
    font-weight: 600;
    margin: 2.25rem 0 0.75rem;
    line-height: 1.3;
  }

  .prose :global(h3) {
    color: #d3c6aa;
    font-size: 1.35rem;
    font-weight: 600;
    margin: 2rem 0 0.5rem;
  }

  .prose :global(h4) {
    color: #d3c6aa;
    font-size: 1.2rem;
    font-weight: 600;
    margin: 1.75rem 0 0.5rem;
  }

  .prose :global(p) {
    margin: 0 0 1.4rem;
  }

  .prose :global(a) {
    color: #83c092;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }

  .prose :global(a:hover) {
    color: #dbbc7f;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.4rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }

  .prose :global(ul li::marker) {
    color: #a7c080;
  }

  .prose :global(ol li::marker) {
    color: #a7c080;
  }

  .prose :global(code) {
    background: #3c484f;
    color: #d3c6aa;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.875em;
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', 'Menlo', 'Consolas', monospace;
  }

  .prose :global(pre) {
    background: #252a2e;
    border: 1px solid #3c484f;
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 0 0 1.5rem;
  }

  .prose :global(pre code) {
    background: none;
    color: #d3c6aa;
    padding: 0;
    font-size: 1.4rem;
    line-height: 1.6;
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', 'Menlo', 'Consolas', monospace;
  }

  .prose :global(blockquote) {
    border-left: 3px solid #a7c080;
    margin: 0 0 1.4rem;
    padding: 0.5rem 0 0.5rem 1.25rem;
    color: #9da9a0;
    font-style: italic;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid #3c484f;
    margin: 2.5rem 0;
  }

  .prose :global(strong) {
    color: #e5dfc8;
    font-weight: 600;
  }

  .prose :global(em) {
    color: #d699b6;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.5rem;
    font-size: 0.9rem;
  }

  .prose :global(th) {
    color: #a7c080;
    font-weight: 600;
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid #3c484f;
  }

  .prose :global(td) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid #3c484f;
  }

  @media (max-width: 600px) {
    main {
      padding: 2.5rem 1.25rem 4rem;
    }

    h1 {
      font-size: 1.6rem;
    }
  }
</style>
